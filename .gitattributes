# Normalize line endings so working-tree bytes match the index on Windows
# (core.autocrlf=true). Upstream issue #144: tracked files materialized as CRLF
# on Windows, breaking Archify's byte-exact template and validator checks.
* text=auto eol=lf

# Deterministic build outputs committed for zero-install operation.
/archify/assets/template.html linguist-generated=true
/archify/renderers/shared/generated-brand-marks.mjs linguist-generated=true
/archify/renderers/shared/generated-validators.mjs linguist-generated=true
/archify/examples/*.html linguist-generated=true
