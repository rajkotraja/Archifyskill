{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__AGENT_KIT_SDLC_HOOKS_DIR__/sdd-cache-pre.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__AGENT_KIT_SDLC_HOOKS_DIR__/simplify-ignore.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__AGENT_KIT_SDLC_HOOKS_DIR__/sdd-cache-post.sh\"",
            "async": true,
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__AGENT_KIT_SDLC_HOOKS_DIR__/simplify-ignore.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__AGENT_KIT_SDLC_HOOKS_DIR__/simplify-ignore.sh\""
          }
        ]
      }
    ]
  }
}
